---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Get involved" current="/get-involved/">
<section class="page-hero"><div class="container"><p class="eyebrow">Our neighborhood club</p><h1>Help more kids play.</h1><p>Support youth soccer through coaching, volunteering, sponsorship, or a donation.</p></div></section>
<section class="section"><div class="container grid">
<article class="card"><span class="tag">Volunteer</span><h2>Give your time</h2><p>Help support a positive, inclusive experience for local players and families.</p><a class="more" href="mailto:info@caphillsoccer.org?subject=Volunteering">Ask about volunteering ↗</a></article>
<article class="card"><span class="tag">Coach</span><h2>Lead a team</h2><p>Coach resources and information about how to get started.</p><a class="more" href="/coaches/">Coaches' resources →</a></article>
<article class="card"><span class="tag">Support</span><h2>Donate or sponsor</h2><p>Help the club keep recreational soccer accessible. Contact us for current donation and sponsorship arrangements.</p><a class="more" href="mailto:info@caphillsoccer.org?subject=Club%20support">Contact the club ↗</a></article>
</div></section><section class="section highlight"><div class="container"><p class="eyebrow">Community partners</p><h2>Thank you to our supporters.</h2><p>The existing club website recognizes Darigold as a sponsor. Sponsor artwork and donation processing links should be confirmed before launch.</p></div></section>
</SiteLayout>
