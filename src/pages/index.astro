---
import { getEntry, render } from "astro:content";
const home = await getEntry("pages", "home");
if (!home) throw new Error("Missing home page content");
const { Content } = await render(home);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={home.data.description ?? ""} />
    <title>{home.data.title}</title>
    <style is:global>
      :root { font-family: system-ui, sans-serif; color: #182b28; background: #f8faf7; }
      body { max-width: 62rem; margin: 0 auto; padding: 2rem; line-height: 1.6; }
      header { border-bottom: 1px solid #ccd5ce; margin-bottom: 3rem; }
      h1 { font-size: clamp(2rem, 6vw, 4rem); line-height: 1.1; }
    </style>
  </head>
  <body>
    <header><strong>Capitol Hill Soccer Club</strong></header>
    <main><h1>{home.data.title}</h1><Content /></main>
  </body>
</html>
